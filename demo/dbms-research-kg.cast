[29.826992, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[33ma:Problem \u001b[0m\u001b[1;33m{\u001b[0m\u001b[33mid: \u001b[0m\r\n\u001b[33m'01-relational-theory/acyclic-join-dependencies'\u001b[0m\u001b[1;33m}\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33mr:RELATED_TO\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mb:Problem\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN b.title AS \u001b[0m\r\n\u001b[33mrelated_problem, r.shared_papers AS shared_papers, r.score AS score ORDER BY score DESC, \u001b[0m\r\n\u001b[33mrelated_problem LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[29.833833, "o", "\u001b[1;35mrelated_problem                                  \u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35mshared_papers\u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35mscore\u001b[0m\r\nSemijoin Reducers for Cyclic Queries               3              0.421\r\nProvenance-aware / semiring execution cost         2              0.238\r\nOptimal Semijoin Reduction Programs                2              0.235\r\nPhysical layout selection for semistructured data  1              0.235\r\nTractable CQs via Treewidth/Submodular Width       1              0.217\r\n"]
