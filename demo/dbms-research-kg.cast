[26.108914, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mp:Problem\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:HAS_GAP\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mg:Gap\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN g.verdict AS gap_verdict, \u001b[0m\u001b[1;33mcount\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mp\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS \u001b[0m\r\n\u001b[33mproblems, \u001b[0m\u001b[1;33msum\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mCASE WHEN g.verdict_method = \u001b[0m\u001b[33m'stated'\u001b[0m\u001b[33m THEN \u001b[0m\u001b[1;33m1\u001b[0m\u001b[33m ELSE \u001b[0m\u001b[1;33m0\u001b[0m\u001b[33m END\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS stated_by_the_page ORDER \u001b[0m\r\n\u001b[33mBY problems DESC\u001b[0m\r\n"]
