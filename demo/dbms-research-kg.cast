[33.540262, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33ma:C\u001b[0m\u001b[33moncept\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:GENERALIZES\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mb:C\u001b[0m\u001b[33moncept\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE a.name CONTAINS \u001b[0m\u001b[33m'width'\u001b[0m\u001b[33m OR b.name \u001b[0m\r\n\u001b[33mCONTAINS \u001b[0m\u001b[33m'width'\u001b[0m\u001b[33m OR b.name = \u001b[0m\u001b[33m'acyclicity'\u001b[0m\u001b[33m RETURN a.name AS broader, b.name AS narrower ORDER BY \u001b[0m\r\n\u001b[33mbroader, narrower\u001b[0m\r\n"]
[33.543729, "o", "\u001b[1;35mbroader                   \u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35mnarrower                  \u001b[0m\r\nfractional hypertree width  hypertree width           \r\nhypertree width             acyclicity                \r\nhypertree width             treewidth                 \r\nsubmodular width            fractional hypertree width\r\n"]
